<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DaD___DialogArtDream</title>
    <link rel="stylesheet" href="~/css/site.css" /> <!-- стиль шапки -->
    <link rel="stylesheet" href="~/css/index.css" /> <!-- стиль главной страницы -->

    <!--
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/DaD___DialogArtDream.styles.css" asp-append-version="true" />
    -->
</head>
<body>
    <!-- Верхняя панель -->
    <header class="top-bar">
        <div class="logo">DialogArtDream</div>
        <div class="top-icons">
            <span class="icon">🔍</span> <!-- Иконка поиска -->
            <span class="icon">⚙️</span> <!-- Иконка настроек -->
            <span class="icon">🔔</span> <!-- Иконка уведомлений -->

            @if (User.IsInRole("Admin"))
            {
                <span class="icon">🛠️</span> <!-- Дополнительная иконка для админа -->
            }

            <div class="loggedin-user">
                <span class="loggedin-username">User123</span>
                <img src="~/images/icon.gif" alt="Avatar" class="loggedin-user-avatar" />
                <span class="dropdown-icon">▼</span>
            </div>
        </div>
    </header>

    <!-- Левая панель -->
    <nav class="left-bar">
        <div class="menu-icon">☰</div>
        <div class="nav-icons">
            <div class="nav-icon">☖</div>
            <div class="nav-icon">👨‍👦‍👦</div>
            <div class="nav-icon">✉</div>
            <div class="nav-icon">📖</div>
            <div class="nav-icon">👤</div>
            <div class="nav-icon">🗓</div>
        </div>
    </nav>

    <!-- Основной контент -->
    <div class="main-content" id="main-content">
        <div id="content-area">
            @RenderBody()
        </div>
    </div>

    <!-- Подключение скриптов -->
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" defer></script>

</body>
</html>
